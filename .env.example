APP_URL=http://localhost:8080
APP_ENV=dev
SERVER_PORT=8080

SPRING_DATASOURCE_URL=jdbc:postgresql://aws-1-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require&prepareThreshold=0
SPRING_DATASOURCE_USERNAME=postgres.TU_PROJECT_REF
SPRING_DATASOURCE_PASSWORD=TU_DB_PASSWORD

SUPABASE_PROJECT_REF=TU_PROJECT_REF
SUPABASE_URL=https://TU_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=TU_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=TU_SUPABASE_SERVICE_ROLE_KEY

SUPABASE_BUCKET_PRODUCTOS=productos
SUPABASE_BUCKET_USUARIOS=usuarios
SUPABASE_BUCKET_MEDIA=media
SUPABASE_STORAGE_PUBLIC=true

OPENROUTER_API_KEY=TU_OPENROUTER_API_KEY
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_CHAT_MODEL=anthropic/claude-3.5-haiku
OPENROUTER_TEXT_MODEL=anthropic/claude-3.5-haiku
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image-preview
OPENROUTER_MEDIA_MODEL=anthropic/claude-3.5-haiku
OPENROUTER_SITE_URL=http://localhost:8080
OPENROUTER_APP_NAME=WebIA-Supabase

IA_MAX_TOKENS_CHAT=2000
IA_MAX_TOKENS_TEXT=1500
IA_TEMPERATURE=0.7
IA_TIMEOUT_MS=60000
IA_RATE_LIMIT_PER_MIN=20

MAX_FILE_SIZE_MB=10
MAX_REQUEST_SIZE_MB=20
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/gif,image/svg+xml
ALLOWED_VIDEO_TYPES=video/mp4,video/webm,video/ogg

JWT_SECRET=CAMBIAR_A_UNA_CLAVE_SECRETA
JWT_EXPIRATION_MS=86400000

LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG

ADMIN_EMAIL=admin@demo.com
ADMIN_PASSWORD=Admin@1234
ADMIN_NOMBRE=Admin
ADMIN_APELLIDO=Demo
DEMO_DATA=true
